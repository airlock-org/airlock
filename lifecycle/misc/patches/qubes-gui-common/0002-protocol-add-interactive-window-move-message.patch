From db356922d46622f77a27389e41ea8fa35f7b3178 Mon Sep 17 00:00:00 2001
From: Airlock Developers <airlock@example.invalid>
Date: Wed, 16 Sep 2026 01:26:55 +0100
Subject: [PATCH] protocol: add interactive window move message

---
 include/qubes-gui-protocol.h | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/include/qubes-gui-protocol.h b/include/qubes-gui-protocol.h
index d4fc493..c41c679 100644
--- a/include/qubes-gui-protocol.h
+++ b/include/qubes-gui-protocol.h
@@ -57,6 +57,8 @@
  *    can safely unmap a window's grants
  * 1.8:
  *  - configurable maximum clipboard size per VM and/or GUIVM.
+ * 1.9:
+ *  - introduce MSG_WINDOW_MOVERESIZE for interactive window moves.
  */

 #ifdef _WIN32
@@ -68,7 +70,7 @@
 /* version of protocol described in this file, used as gui-daemon protocol
  * version; specific agent defines own version which them support */
 #define QUBES_GUID_PROTOCOL_VERSION_MAJOR 1
-#define QUBES_GUID_PROTOCOL_VERSION_MINOR 8
+#define QUBES_GUID_PROTOCOL_VERSION_MINOR 9
 #define QUBES_GUID_PROTOCOL_VERSION (QUBES_GUID_PROTOCOL_VERSION_MAJOR << 16 | QUBES_GUID_PROTOCOL_VERSION_MINOR)

 /* Before this version, MSG_CLIPBOARD_DATA passed the length in the window field */
@@ -86,6 +88,9 @@
 /* Minimum version for (up to) 4x sized clipboard */
 #define QUBES_GUID_MIN_CLIPBOARD_4X 0x00010008

+/* Minimum version for MSG_WINDOW_MOVERESIZE */
+#define QUBES_GUID_MIN_WINDOW_MOVERESIZE 0x00010009
+
 //arbitrary
 #define MAX_CLIPBOARD_SIZE 65000              // protocol 1.7 or older

@@ -163,6 +168,7 @@ enum {
     MSG_WINDOW_DUMP,
     MSG_CURSOR,
     MSG_WINDOW_DUMP_ACK,
+    MSG_WINDOW_MOVERESIZE,
     MSG_MAX,
 };
 /* Agent -> Daemon, Daemon -> Agent */
@@ -291,6 +297,15 @@ struct msg_window_flags {
 #define WINDOW_FLAG_MAXIMIZE_VERT        (1<<3)
 #define WINDOW_FLAG_MAXIMIZE_HORZ        (1<<4)

+/* Agent -> Daemon.  The daemon uses the trusted host pointer coordinates. */
+struct msg_window_moveresize {
+    uint32_t direction;
+    uint32_t button;
+} __attribute__((may_alias));
+
+/* _NET_WM_MOVERESIZE direction used for a pointer-driven window move. */
+#define WINDOW_MOVERESIZE_MOVE 8
+
 /* Agent -> Daemon, deprecated */
 struct shm_cmd {
     uint32_t shmid;
--
2.54.0
