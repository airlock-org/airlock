From 1ef5e8c4b80c33d83c1ddf406000000000000000 Mon Sep 17 00:00:00 2001
From: Airlock <noreply@airlock.local>
Date: Thu, 11 Sep 2026 12:00:00 +0100
Subject: [PATCH] libxl: enable HVM PIRQ for PCI passthrough domains

Xen 4.19 disables the HVM PIRQ feature by default. Qubes HVM domains with
assigned PCI devices require it for passthrough device interrupts to reach
the guest. Limit the feature to HVMs for which libvirt has created at least
one PCI passthrough device.
---
 src/libxl/libxl_conf.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/libxl/libxl_conf.c b/src/libxl/libxl_conf.c
index 753acf171e..34c06fe441 100644
--- a/src/libxl/libxl_conf.c
+++ b/src/libxl/libxl_conf.c
@@ -2554,6 +2554,14 @@ libxlBuildDomainConfig(virPortAllocatorRange *graphicsports,
     if (libxlMakePCIList(def, d_config) < 0)
         return -1;
 
+#ifdef LIBXL_HAVE_HVM_PIRQ
+    /* PCI passthrough needs Xen's HVM PIRQ feature for device interrupts. */
+    if (def->os.type == VIR_DOMAIN_OSTYPE_HVM &&
+        d_config->num_pcidevs > 0) {
+        libxl_defbool_set(&d_config->b_info.u.hvm.pirq, true);
+    }
+#endif
+
     if (libxlMakeUSBControllerList(def, d_config) < 0)
         return -1;
 
-- 
