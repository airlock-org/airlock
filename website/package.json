{
  "name": "airlock-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "prepare:docs": "python3 scripts/prepare-docs.py",
    "dev": "python3 scripts/dev.py",
    "build": "pnpm prepare:docs && next build",
    "check": "pnpm prepare:docs && fumadocs-mdx && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.1",
    "lucide-react": "0.564.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
