+/* Run on the Xorg main thread. Keep every drawing address stable while
+ * replacing grants: clients, pixmaps and the X server remain alive. Linux's
+ * gntalloc driver releases grants when their final VMA is removed. */
+Bool xf86_qubes_reconnect(uint32_t domid, Bool connected) {
+    DUMMYPtr dPtr = DUMMYPTR(DUMMYScrn);
+    struct xf86_qubes_pixmap *priv;
+    if (domid > UINT16_MAX)
+        return FALSE;
+    xf86_qubes_pixmap_remove_list_all();
+    gui_detached = !connected;
+    dPtr->gui_domid = domid;
+    for (priv = all_pixmaps; priv; priv = priv->next) {
+        size_t bytes = priv->pages * XC_PAGE_SIZE;
+        uint32_t *refs = calloc(priv->pages, sizeof(*refs));
+        void *replacement;
+        if (!refs)
+            return FALSE;
+        replacement = connected
+            ? xengntshr_share_pages(dPtr->xgs, domid, priv->pages, refs, 0)
+            : mmap(NULL, bytes, PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        if (!replacement || replacement == MAP_FAILED) {
+            free(refs);
+            return FALSE;
+        }
+        memcpy(replacement, priv->data, bytes);
+        if (mremap(replacement, bytes, bytes, MREMAP_MAYMOVE | MREMAP_FIXED,
+                   priv->data) == MAP_FAILED) {
+            munmap(replacement, bytes);
+            free(refs);
+            return FALSE;
+        }
+        memcpy(priv->refs, refs, priv->pages * sizeof(*refs));
+        priv->shared = connected;
+        free(refs);
+    }
+    xf86DrvMsg(DUMMYScrn->scrnIndex, X_INFO,
+               "Airlock: display buffers %s for GuiVM %u\n",
+               connected ? "regranted" : "detached", domid);
+    return TRUE;
+}
