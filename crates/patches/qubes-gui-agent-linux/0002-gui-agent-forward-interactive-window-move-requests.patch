From cc0617bc3199af677b2691b83a6f345e234b56f2 Mon Sep 17 00:00:00 2001
From: Airlock Developers <airlock@example.invalid>
Date: Wed, 16 Sep 2026 01:26:55 +0100
Subject: [PATCH] gui-agent: forward interactive window move requests

---
 gui-agent/vmside.c | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/gui-agent/vmside.c b/gui-agent/vmside.c
index 0fa5bd5..2bfb58d 100644
--- a/gui-agent/vmside.c
+++ b/gui-agent/vmside.c
@@ -77,7 +77,7 @@
 /* Supported protocol version */

 #define PROTOCOL_VERSION_MAJOR 1
-#define PROTOCOL_VERSION_MINOR 8
+#define PROTOCOL_VERSION_MINOR 9
 #define PROTOCOL_VERSION (PROTOCOL_VERSION_MAJOR << 16 | PROTOCOL_VERSION_MINOR)

 #if !(PROTOCOL_VERSION_MAJOR == QUBES_GUID_PROTOCOL_VERSION_MAJOR && \
@@ -119,6 +119,7 @@ typedef struct {
     Atom wm_state_maximized_vert; /* Atom: _NET_WM_STATE_MAXIMIZED_VERT */
     Atom wm_state_maximized_horz; /* Atom: _NET_WM_STATE_MAXIMIZED_HORZ */
     Atom wm_change_state;  /* Atom: WM_CHANGE_STATE */
+    Atom wm_moveresize;    /* Atom: _NET_WM_MOVERESIZE */
     Atom wm_take_focus;    /* Atom: WM_TAKE_FOCUS */
     Atom net_wm_name;      /* Atom: _NET_WM_NAME */
     Atom wm_normal_hints;  /* Atom: WM_NORMAL_HINTS */
@@ -1599,6 +1600,22 @@ static void process_xevent_message(Ghandles * g, XClientMessageEvent * ev)
         hdr.window = ev->window;
         hdr.type = MSG_WINDOW_FLAGS;
         write_message(g->vchan, hdr, msg);
+    } else if (ev->message_type == g->wm_moveresize && ev->format == 32 &&
+            ev->data.l[2] == WINDOW_MOVERESIZE_MOVE &&
+            g->protocol_version >= QUBES_GUID_MIN_WINDOW_MOVERESIZE) {
+        struct msg_hdr hdr;
+        struct msg_window_moveresize msg = {
+            .direction = WINDOW_MOVERESIZE_MOVE,
+            .button = (uint32_t)ev->data.l[3],
+        };
+
+        if (!lookup_window(g, windows_list, ev->window,
+                "_NET_WM_MOVERESIZE"))
+            return;
+
+        hdr.window = ev->window;
+        hdr.type = MSG_WINDOW_MOVERESIZE;
+        write_message(g->vchan, hdr, msg);
     }
 }

@@ -1924,6 +1941,7 @@ static void mkghandles(Ghandles * g)
     for (size_t i = 0; i < QUBES_ARRAY_SIZE(atoms_to_intern); ++i)
         *atoms_to_intern[i].dest = supported[SUPPORTED_ATOMS + i];
     const Atom net_supported = supported[0], net_supporting_wm_check = supported[1];
+    g->wm_moveresize = supported[2];
     XChangeProperty(g->display, g->stub_win, g->net_wm_name, g->utf8_string_atom,
             8, PropModeReplace, (unsigned char*)"Qubes", 5);
     XChangeProperty(g->display, g->stub_win, net_supporting_wm_check, XA_WINDOW,
--
2.54.0
