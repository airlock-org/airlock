From 39578f1c931ef1690f76f814e7cd621a2f7cfe0d Mon Sep 17 00:00:00 2001
From: Airlock Developers <airlock@example.invalid>
Date: Wed, 16 Sep 2026 01:01:43 +0100
Subject: [PATCH] gui-daemon: apply maximize window flags

---
 gui-daemon/xside.c | 59 ++++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 55 insertions(+), 4 deletions(-)

diff --git a/gui-daemon/xside.c b/gui-daemon/xside.c
index 3661560..257c2e3 100644
--- a/gui-daemon/xside.c
+++ b/gui-daemon/xside.c
@@ -2528,6 +2528,10 @@ static inline uint32_t flags_from_atom(Ghandles * g, Atom a) {
         return WINDOW_FLAG_DEMANDS_ATTENTION;
     else if (a == g->wm_state_hidden)
         return WINDOW_FLAG_MINIMIZE;
+    else if (a == g->wm_state_maximized_vert)
+        return WINDOW_FLAG_MAXIMIZE_VERT;
+    else if (a == g->wm_state_maximized_horz)
+        return WINDOW_FLAG_MAXIMIZE_HORZ;
     else {
         /* ignore unsupported states */
     }
@@ -2584,6 +2588,8 @@ static void process_xevent_propertynotify(Ghandles *g, const XPropertyEvent *con
                 if (maximize_flags_seen == 3) {
                     /* if fullscreen request was converted to maximize request,
                      * then convert maximize ack to fullscreen ack */
+                    flags &= ~(WINDOW_FLAG_MAXIMIZE_VERT |
+                            WINDOW_FLAG_MAXIMIZE_HORZ);
                     flags |= WINDOW_FLAG_FULLSCREEN;
                 } else {
                     /* going out of emulated fullscreen mode */
@@ -3304,10 +3310,14 @@ static void handle_wmflags(Ghandles * g, struct windowdata *vm_window)
     msg.flags_set = untrusted_msg.flags_set & (
             WINDOW_FLAG_FULLSCREEN |
             WINDOW_FLAG_DEMANDS_ATTENTION |
-            WINDOW_FLAG_MINIMIZE);
+            WINDOW_FLAG_MINIMIZE |
+            WINDOW_FLAG_MAXIMIZE_VERT |
+            WINDOW_FLAG_MAXIMIZE_HORZ);
     msg.flags_unset = untrusted_msg.flags_unset & (
             WINDOW_FLAG_FULLSCREEN |
-            WINDOW_FLAG_DEMANDS_ATTENTION);
+            WINDOW_FLAG_DEMANDS_ATTENTION |
+            WINDOW_FLAG_MAXIMIZE_VERT |
+            WINDOW_FLAG_MAXIMIZE_HORZ);
     /* sanitize end */
 
     if (!vm_window->is_mapped) {
@@ -3316,7 +3326,10 @@ static void handle_wmflags(Ghandles * g, struct windowdata *vm_window)
         Atom state_list[10];
         int i = 0;
 
-        vm_window->flags_set &= ~(WINDOW_FLAG_FULLSCREEN | WINDOW_FLAG_DEMANDS_ATTENTION);
+        vm_window->flags_set &= ~(WINDOW_FLAG_FULLSCREEN |
+                WINDOW_FLAG_DEMANDS_ATTENTION |
+                WINDOW_FLAG_MAXIMIZE_VERT |
+                WINDOW_FLAG_MAXIMIZE_HORZ);
         if (msg.flags_set & WINDOW_FLAG_FULLSCREEN) {
             if (g->allow_fullscreen) {
                 vm_window->flags_set |= WINDOW_FLAG_FULLSCREEN;
@@ -3337,6 +3350,14 @@ static void handle_wmflags(Ghandles * g, struct windowdata *vm_window)
             vm_window->flags_set |= WINDOW_FLAG_DEMANDS_ATTENTION;
             state_list[i++] = g->wm_state_demands_attention;
         }
+        if (msg.flags_set & WINDOW_FLAG_MAXIMIZE_VERT) {
+            vm_window->flags_set |= WINDOW_FLAG_MAXIMIZE_VERT;
+            state_list[i++] = g->wm_state_maximized_vert;
+        }
+        if (msg.flags_set & WINDOW_FLAG_MAXIMIZE_HORZ) {
+            vm_window->flags_set |= WINDOW_FLAG_MAXIMIZE_HORZ;
+            state_list[i++] = g->wm_state_maximized_horz;
+        }
         if (i > 0) {
             /* FIXME: error checking? */
             XChangeProperty(g->display, vm_window->local_winid, g->wm_state,
@@ -3396,7 +3417,7 @@ static void handle_wmflags(Ghandles * g, struct windowdata *vm_window)
                     (SubstructureNotifyMask|SubstructureRedirectMask),
                     (XEvent*) &ev);
         }
-        if (msg.flags_set & WINDOW_FLAG_DEMANDS_ATTENTION) {
+        if (flags_all & WINDOW_FLAG_DEMANDS_ATTENTION) {
             ev.data.l[0] = (msg.flags_set & WINDOW_FLAG_DEMANDS_ATTENTION) ? 1 : 0;
             ev.data.l[1] = g->wm_state_demands_attention;
             ev.data.l[2] = 0;
@@ -3404,6 +3425,36 @@ static void handle_wmflags(Ghandles * g, struct windowdata *vm_window)
                     (SubstructureNotifyMask|SubstructureRedirectMask),
                     (XEvent*) &ev);
         }
+        const uint32_t maximize_flags = WINDOW_FLAG_MAXIMIZE_VERT |
+                WINDOW_FLAG_MAXIMIZE_HORZ;
+        if ((flags_all & maximize_flags) == maximize_flags &&
+                ((msg.flags_set & maximize_flags) == maximize_flags ||
+                 (msg.flags_unset & maximize_flags) == maximize_flags)) {
+            /* Keep the two-dimensional maximize transition atomic. */
+            ev.data.l[0] = (msg.flags_set & maximize_flags) ? 1 : 0;
+            ev.data.l[1] = g->wm_state_maximized_vert;
+            ev.data.l[2] = g->wm_state_maximized_horz;
+            XSendEvent(g->display, g->root_win, False,
+                    (SubstructureNotifyMask|SubstructureRedirectMask),
+                    (XEvent*) &ev);
+        } else {
+            if (flags_all & WINDOW_FLAG_MAXIMIZE_VERT) {
+                ev.data.l[0] = (msg.flags_set & WINDOW_FLAG_MAXIMIZE_VERT) ? 1 : 0;
+                ev.data.l[1] = g->wm_state_maximized_vert;
+                ev.data.l[2] = 0;
+                XSendEvent(g->display, g->root_win, False,
+                        (SubstructureNotifyMask|SubstructureRedirectMask),
+                        (XEvent*) &ev);
+            }
+            if (flags_all & WINDOW_FLAG_MAXIMIZE_HORZ) {
+                ev.data.l[0] = (msg.flags_set & WINDOW_FLAG_MAXIMIZE_HORZ) ? 1 : 0;
+                ev.data.l[1] = g->wm_state_maximized_horz;
+                ev.data.l[2] = 0;
+                XSendEvent(g->display, g->root_win, False,
+                        (SubstructureNotifyMask|SubstructureRedirectMask),
+                        (XEvent*) &ev);
+            }
+        }
         if (msg.flags_set & WINDOW_FLAG_MINIMIZE) {
             XIconifyWindow(g->display, vm_window->local_winid, g->screen);
         }
-- 
2.54.0

