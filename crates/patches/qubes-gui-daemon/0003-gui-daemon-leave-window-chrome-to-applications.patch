     return xcolor;
 }
 
+/* Only the trusted GuiVM administrator can select a positive border width. */
+static void airlock_reload_border(Ghandles *g)
+{
+    int width = 10;
+    int fd = open("/rw/airlock/gui-border-width", O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd >= 0) {
+        struct stat st;
+        char buffer[32], *end;
+        ssize_t count;
+        if (fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && st.st_uid == 0
+                && !(st.st_mode & 022) && (count = read(fd, buffer, sizeof(buffer) - 1)) > 0) {
+            buffer[count] = 0;
+            long value = strtol(buffer, &end, 10);
+            if ((*end == '\n' && end[1] == 0) || *end == 0) {
+                if (value >= 1 && value <= 16)
+                    width = (int)value;
+            }
+        }
+        close(fd);
+    }
+    g->airlock_border_width = width + 1; /* fixed black contrast edge */
+}
+
 /* prepare graphic context for painting colorful frame and set RGB value of the
