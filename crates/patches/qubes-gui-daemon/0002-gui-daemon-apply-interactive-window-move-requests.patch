From e9f3b48c1b5955a5de50bf64077a69b7344a271b Mon Sep 17 00:00:00 2001
From: Airlock Developers <airlock@example.invalid>
Date: Wed, 16 Sep 2026 01:26:55 +0100
Subject: [PATCH] gui-daemon: apply interactive window move requests

---
 gui-daemon/xside.c | 48 +++++++++++++++++++++++++++++++++++++++++++++-
 gui-daemon/xside.h |  1 +
 2 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/gui-daemon/xside.c b/gui-daemon/xside.c
index 257c2e3..a39d41d 100644
--- a/gui-daemon/xside.c
+++ b/gui-daemon/xside.c
@@ -72,7 +72,7 @@
 /* Supported protocol version */

 #define PROTOCOL_VERSION_MAJOR UINT32_C(1)
-#define PROTOCOL_VERSION_MINOR UINT32_C(8)
+#define PROTOCOL_VERSION_MINOR UINT32_C(9)
 #define PROTOCOL_VERSION(x, y) ((x) << 16 | (y))

 #if !(PROTOCOL_VERSION_MAJOR == QUBES_GUID_PROTOCOL_VERSION_MAJOR && \
@@ -608,6 +608,7 @@ static void intern_global_atoms(Ghandles *const g) {
         { &g->frame_extents, "_NET_FRAME_EXTENTS" },
         { &g->wm_state_maximized_vert, "_NET_WM_STATE_MAXIMIZED_VERT" },
         { &g->wm_state_maximized_horz, "_NET_WM_STATE_MAXIMIZED_HORZ" },
+        { &g->wm_moveresize, "_NET_WM_MOVERESIZE" },
         { &g->qubes_label, "_QUBES_LABEL" },
         { &g->qubes_label_color, "_QUBES_LABEL_COLOR" },
         { &g->qubes_vmname, "_QUBES_VMNAME" },
@@ -3461,6 +3462,45 @@ static void handle_wmflags(Ghandles * g, struct windowdata *vm_window)
     }
 }

+/* Start an interactive host-side move for a guest window.  Guest root
+ * coordinates are deliberately not part of the protocol: the GUI daemon
+ * obtains the current pointer position from its trusted X server. */
+static void handle_window_moveresize(Ghandles *g,
+        struct windowdata *vm_window)
+{
+    struct msg_window_moveresize msg;
+    Window root_return, child_return;
+    int root_x, root_y, win_x, win_y;
+    unsigned int mask;
+    XClientMessageEvent ev = {0};
+
+    read_struct(g->vchan, msg);
+    if (msg.direction != WINDOW_MOVERESIZE_MOVE ||
+            msg.button == 0 || msg.button > 5)
+        return;
+    if (!vm_window->is_mapped || vm_window->override_redirect)
+        return;
+    if (!XQueryPointer(g->display, g->root_win, &root_return, &child_return,
+            &root_x, &root_y, &win_x, &win_y, &mask))
+        return;
+    if (!(mask & (Button1Mask << (msg.button - 1))))
+        return;
+
+    ev.type = ClientMessage;
+    ev.display = g->display;
+    ev.window = vm_window->local_winid;
+    ev.message_type = g->wm_moveresize;
+    ev.format = 32;
+    ev.data.l[0] = root_x;
+    ev.data.l[1] = root_y;
+    ev.data.l[2] = msg.direction;
+    ev.data.l[3] = msg.button;
+    ev.data.l[4] = 1; /* normal application */
+    XSendEvent(g->display, g->root_win, False,
+            SubstructureNotifyMask | SubstructureRedirectMask,
+            (XEvent *)&ev);
+}
+

 /* Check if we should keep this window on top of others */
 static bool should_keep_on_top(Ghandles *g, Window window) {
@@ -4073,6 +4113,12 @@ static void handle_message(Ghandles * g)
         CHECK_LEN(sizeof(struct msg_window_flags), WINDOW_FLAGS);
         handle_wmflags(g, vm_window);
         break;
+    case MSG_WINDOW_MOVERESIZE:
+        if (g->protocol_version < QUBES_GUID_MIN_WINDOW_MOVERESIZE)
+            errx(1, "MSG_WINDOW_MOVERESIZE requires protocol 1.9");
+        CHECK_LEN(sizeof(struct msg_window_moveresize), WINDOW_MOVERESIZE);
+        handle_window_moveresize(g, vm_window);
+        break;
     case MSG_WINDOW_DUMP:
         if (untrusted_len < MSG_WINDOW_DUMP_HDR_LEN)
             msg_too_short_error("WINDOW_DUMP", untrusted_len, MSG_WINDOW_DUMP_HDR_LEN);
diff --git a/gui-daemon/xside.h b/gui-daemon/xside.h
index 44a034d..bda6a92 100644
--- a/gui-daemon/xside.h
+++ b/gui-daemon/xside.h
@@ -185,6 +185,7 @@ struct _global_handles {
     Atom frame_extents; /* Atom: _NET_FRAME_EXTENTS */
     Atom wm_state_maximized_vert; /* Atom: _NET_WM_STATE_MAXIMIZED_VERT */
     Atom wm_state_maximized_horz; /* Atom: _NET_WM_STATE_MAXIMIZED_HORZ */
+    Atom wm_moveresize; /* Atom: _NET_WM_MOVERESIZE */
     Atom wm_user_time_window; /* Atom: _NET_WM_USER_TIME_WINDOW */
     Atom wm_user_time; /* Atom: _NET_WM_USER_TIME */
     Atom wm_pid; /* Atom: _NET_WM_PID */
